<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NFT Locked Image Generator</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Courier New', monospace;
            background: #0a0e27;
            background-image: 
                radial-gradient(circle at 20% 50%, rgba(120, 119, 198, 0.3), transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(255, 107, 0, 0.3), transparent 50%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: rgba(15, 20, 40, 0.9);
            border-radius: 25px;
            padding: 40px;
            box-shadow: 
                0 0 60px rgba(255, 107, 0, 0.3),
                0 0 100px rgba(120, 119, 198, 0.2);
            border: 2px solid rgba(255, 107, 0, 0.3);
        }

        h1 {
            color: #ff6b00;
            text-align: center;
            font-size: 2.5em;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 4px;
            text-shadow: 0 0 20px rgba(255, 107, 0, 0.8);
        }

        .subtitle {
            text-align: center;
            color: #00ffa3;
            font-size: 1.2em;
            margin-bottom: 40px;
            letter-spacing: 2px;
        }

        .upload-section {
            background: rgba(0, 0, 0, 0.3);
            border: 3px dashed rgba(255, 107, 0, 0.5);
            border-radius: 15px;
            padding: 40px;
            text-align: center;
            margin-bottom: 30px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .upload-section:hover {
            border-color: #ff6b00;
            background: rgba(255, 107, 0, 0.1);
        }

        .upload-section.dragover {
            border-color: #00ffa3;
            background: rgba(0, 255, 163, 0.1);
        }

        .upload-icon {
            font-size: 4em;
            margin-bottom: 20px;
        }

        .upload-text {
            color: #ff6b00;
            font-size: 1.3em;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .upload-subtext {
            color: #7877c6;
            font-size: 0.9em;
        }

        input[type="file"] {
            display: none;
        }

        .controls {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .control-group {
            background: rgba(0, 0, 0, 0.3);
            padding: 20px;
            border-radius: 15px;
            border: 1px solid rgba(255, 107, 0, 0.3);
        }

        .control-label {
            color: #ff6b00;
            font-size: 0.9em;
            margin-bottom: 10px;
            display: block;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        input[type="range"] {
            width: 100%;
            height: 8px;
            border-radius: 5px;
            background: rgba(0, 0, 0, 0.5);
            outline: none;
            border: 1px solid rgba(255, 107, 0, 0.3);
        }

        input[type="range"]::-webkit-slider-thumb {
            appearance: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #ff6b00;
            cursor: pointer;
            box-shadow: 0 0 10px rgba(255, 107, 0, 0.8);
        }

        input[type="text"] {
            width: 100%;
            padding: 12px;
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 107, 0, 0.3);
            border-radius: 8px;
            color: #00ffa3;
            font-family: 'Courier New', monospace;
            font-size: 1em;
        }

        .value-display {
            color: #00ffa3;
            font-size: 1.2em;
            text-align: center;
            margin-top: 10px;
            font-weight: bold;
        }

        .preview-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }

        .preview-box {
            background: rgba(0, 0, 0, 0.3);
            border: 2px solid rgba(255, 107, 0, 0.3);
            border-radius: 15px;
            padding: 20px;
            text-align: center;
        }

        .preview-title {
            color: #ff6b00;
            font-size: 1.2em;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        canvas {
            max-width: 100%;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
        }

        .button-group {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        button {
            padding: 15px 40px;
            border: 2px solid;
            border-radius: 12px;
            font-size: 1.1em;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-family: 'Courier New', monospace;
        }

        .btn-download {
            background: rgba(0, 255, 163, 0.2);
            color: #00ffa3;
            border-color: #00ffa3;
            box-shadow: 0 0 20px rgba(0, 255, 163, 0.3);
        }

        .btn-download:hover:not(:disabled) {
            background: rgba(0, 255, 163, 0.4);
            transform: translateY(-3px);
            box-shadow: 0 5px 30px rgba(0, 255, 163, 0.6);
        }

        .btn-reset {
            background: rgba(120, 119, 198, 0.2);
            color: #7877c6;
            border-color: #7877c6;
            box-shadow: 0 0 20px rgba(120, 119, 198, 0.3);
        }

        .btn-reset:hover {
            background: rgba(120, 119, 198, 0.4);
            transform: translateY(-3px);
            box-shadow: 0 5px 30px rgba(120, 119, 198, 0.6);
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .instructions {
            background: rgba(0, 255, 163, 0.1);
            border: 1px solid rgba(0, 255, 163, 0.3);
            border-radius: 15px;
            padding: 20px;
            margin-top: 30px;
        }

        .instructions h3 {
            color: #00ffa3;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .instructions ol {
            color: #7877c6;
            padding-left: 25px;
        }

        .instructions li {
            margin-bottom: 10px;
            line-height: 1.6;
        }

        @media (max-width: 768px) {
            .preview-section {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🔒 NFT LOCKED IMAGE GENERATOR</h1>
        <p class="subtitle">⟨ CREATE YOUR OPENSEA PREVIEW IN SECONDS ⟩</p>

        <div class="upload-section" id="uploadSection">
            <div class="upload-icon">📤</div>
            <div class="upload-text">Click or Drag Your NFT Image Here</div>
            <div class="upload-subtext">Supports: JPG, PNG, GIF (Max 10MB)</div>
            <input type="file" id="fileInput" accept="image/*">
        </div>

        <div class="controls">
            <div class="control-group">
                <label class="control-label">🌫️ Blur Amount</label>
                <input type="range" id="blurAmount" min="0" max="100" value="50">
                <div class="value-display" id="blurValue">50px</div>
            </div>

            <div class="control-group">
                <label class="control-label">🌑 Darkness Overlay</label>
                <input type="range" id="darkness" min="0" max="100" value="50">
                <div class="value-display" id="darknessValue">50%</div>
            </div>

            <div class="control-group">
                <label class="control-label">📝 Main Text</label>
                <input type="text" id="mainText" value="🔒 LOCKED">
            </div>

            <div class="control-group">
                <label class="control-label">📝 Sub Text</label>
                <input type="text" id="subText" value="PURCHASE TO UNLOCK">
            </div>
        </div>

        <div class="preview-section">
            <div class="preview-box">
                <div class="preview-title">⟨ ORIGINAL IMAGE ⟩</div>
                <canvas id="originalCanvas"></canvas>
            </div>

            <div class="preview-box">
                <div class="preview-title">⟨ LOCKED VERSION ⟩</div>
                <canvas id="lockedCanvas"></canvas>
            </div>
        </div>

        <div class="button-group">
            <button class="btn-download" id="downloadBtn" disabled>
                💾 DOWNLOAD LOCKED.PNG
            </button>
            <button class="btn-reset" id="resetBtn">
                🔄 RESET
            </button>
        </div>

        <div class="instructions">
            <h3>📋 HOW TO USE:</h3>
            <ol>
                <li><strong>Upload</strong> your original NFT image (the full artwork)</li>
                <li><strong>Adjust</strong> blur, darkness, and text to your liking</li>
                <li><strong>Preview</strong> the locked version in real-time</li>
                <li><strong>Download</strong> your locked.png file</li>
                <li><strong>Upload</strong> locked.png to IPFS for OpenSea metadata</li>
            </ol>
        </div>
    </div>

    <script>
        const uploadSection = document.getElementById('uploadSection');
        const fileInput = document.getElementById('fileInput');
        const originalCanvas = document.getElementById('originalCanvas');
        const lockedCanvas = document.getElementById('lockedCanvas');
        const blurAmount = document.getElementById('blurAmount');
        const darkness = document.getElementById('darkness');
        const mainText = document.getElementById('mainText');
        const subText = document.getElementById('subText');
        const blurValue = document.getElementById('blurValue');
        const darknessValue = document.getElementById('darknessValue');
        const downloadBtn = document.getElementById('downloadBtn');
        const resetBtn = document.getElementById('resetBtn');

        let originalImage = null;
        const originalCtx = originalCanvas.getContext('2d');
        const lockedCtx = lockedCanvas.getContext('2d');

        // Upload handling
        uploadSection.addEventListener('click', () => fileInput.click());
        
        uploadSection.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadSection.classList.add('dragover');
        });

        uploadSection.addEventListener('dragleave', () => {
            uploadSection.classList.remove('dragover');
        });

        uploadSection.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadSection.classList.remove('dragover');
            const file = e.dataTransfer.files[0];
            if (file && file.type.startsWith('image/')) {
                loadImage(file);
            }
        });

        fileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                loadImage(file);
            }
        });

        function loadImage(file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                originalImage = new Image();
                originalImage.onload = () => {
                    setupCanvases();
                    drawOriginal();
                    generateLocked();
                    downloadBtn.disabled = false;
                };
                originalImage.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function setupCanvases() {
            const size = Math.min(originalImage.width, originalImage.height, 800);
            originalCanvas.width = size;
            originalCanvas.height = size;
            lockedCanvas.width = size;
            lockedCanvas.height = size;
        }

        function drawOriginal() {
            const size = originalCanvas.width;
            originalCtx.clearRect(0, 0, size, size);
            
            // Calculate dimensions to fit and center
            const scale = Math.min(size / originalImage.width, size / originalImage.height);
            const w = originalImage.width * scale;
            const h = originalImage.height * scale;
            const x = (size - w) / 2;
            const y = (size - h) / 2;
            
            originalCtx.drawImage(originalImage, x, y, w, h);
        }

        function generateLocked() {
            const size = lockedCanvas.width;
            lockedCtx.clearRect(0, 0, size, size);
            
            // Calculate dimensions
            const scale = Math.min(size / originalImage.width, size / originalImage.height);
            const w = originalImage.width * scale;
            const h = originalImage.height * scale;
            const x = (size - w) / 2;
            const y = (size - h) / 2;
            
            // Draw blurred image
            lockedCtx.filter = `blur(${blurAmount.value}px)`;
            lockedCtx.drawImage(originalImage, x, y, w, h);
            lockedCtx.filter = 'none';
            
            // Add darkness overlay
            const darkValue = darkness.value / 100;
            lockedCtx.fillStyle = `rgba(0, 0, 0, ${darkValue})`;
            lockedCtx.fillRect(0, 0, size, size);
            
            // Add gradient overlay
            const gradient = lockedCtx.createLinearGradient(0, 0, size, size);
            gradient.addColorStop(0, 'rgba(255, 107, 0, 0.1)');
            gradient.addColorStop(0.5, 'rgba(120, 119, 198, 0.1)');
            gradient.addColorStop(1, 'rgba(0, 255, 163, 0.1)');
            lockedCtx.fillStyle = gradient;
            lockedCtx.fillRect(0, 0, size, size);
            
            // Add main text
            const fontSize = size / 10;
            lockedCtx.font = `bold ${fontSize}px Courier New`;
            lockedCtx.textAlign = 'center';
            lockedCtx.textBaseline = 'middle';
            
            // Text shadow/glow
            lockedCtx.shadowColor = '#ff6b00';
            lockedCtx.shadowBlur = 20;
            lockedCtx.fillStyle = '#ff6b00';
            lockedCtx.fillText(mainText.value, size / 2, size / 2 - fontSize / 2);
            
            // Add sub text
            const subFontSize = size / 20;
            lockedCtx.font = `bold ${subFontSize}px Courier New`;
            lockedCtx.shadowColor = '#00ffa3';
            lockedCtx.fillStyle = '#00ffa3';
            lockedCtx.fillText(subText.value, size / 2, size / 2 + fontSize);
            
            // Reset shadow
            lockedCtx.shadowBlur = 0;
            
            // Add lock icon
            lockedCtx.font = `${fontSize * 1.5}px Arial`;
            lockedCtx.fillStyle = '#ffffff';
            lockedCtx.shadowColor = '#ffffff';
            lockedCtx.shadowBlur = 30;
            lockedCtx.fillText('🔒', size / 2, size / 2 - fontSize * 2);
            lockedCtx.shadowBlur = 0;
        }

        // Update controls
        blurAmount.addEventListener('input', (e) => {
            blurValue.textContent = e.target.value + 'px';
            if (originalImage) generateLocked();
        });

        darkness.addEventListener('input', (e) => {
            darknessValue.textContent = e.target.value + '%';
            if (originalImage) generateLocked();
        });

        mainText.addEventListener('input', () => {
            if (originalImage) generateLocked();
        });

        subText.addEventListener('input', () => {
            if (originalImage) generateLocked();
        });

        // Download
        downloadBtn.addEventListener('click', () => {
            const link = document.createElement('a');
            link.download = 'locked.png';
            link.href = lockedCanvas.toDataURL('image/png');
            link.click();
        });

        // Reset
        resetBtn.addEventListener('click', () => {
            originalImage = null;
            originalCtx.clearRect(0, 0, originalCanvas.width, originalCanvas.height);
            lockedCtx.clearRect(0, 0, lockedCanvas.width, lockedCanvas.height);
            fileInput.value = '';
            downloadBtn.disabled = true;
            blurAmount.value = 50;
            darkness.value = 50;
            blurValue.textContent = '50px';
            darknessValue.textContent = '50%';
            mainText.value = '🔒 LOCKED';
            subText.value = 'PURCHASE TO UNLOCK';
        });
    </script>
</body>
</html>
